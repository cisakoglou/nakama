NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
APP_ORIGIN=http://localhost:3002
SUPABASE_SECRET_KEY=sb_secret_replace_me
HEVY_CREDENTIAL_ENCRYPTION_KEY=replace_with_32_random_bytes_in_base64
# Optional OAuth backend; register $APP_ORIGIN/api/hevy/oauth/callback in Hevy.
HEVY_OAUTH_CLIENT_ID=
HEVY_OAUTH_CLIENT_SECRET=
ANTHROPIC_API_KEY=replace_me
# Optional: Web Push for "report ready" notifications. Generate with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
